
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#101827">

    <LinearLayout
        android:layout_width="220dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#192638">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DİLEKÇİ WORLD TV PREMIUM"
            android:textColor="#EAC66D"
            android:textSize="19sp"
            android:textStyle="bold"
            android:paddingBottom="16dp"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:focusable="false">

            <LinearLayout
                android:id="@+id/sectionContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </ScrollView>

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/sectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ana Sayfa"
            android:textColor="#EAC66D"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/contentTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dilekçi World TV Premium"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/contentDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dünyanın ekranı"
            android:textColor="#CCCCCC"
            android:textSize="15sp"
            android:layout_marginTop="6dp"/>

        <Button
            android:id="@+id/primaryAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Canlı TV"
            android:visibility="gone"/>

        <Button
            android:id="@+id/secondaryAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filmler"
            android:visibility="gone"/>

    </LinearLayout>

</LinearLayout>
